# Supabase Postgres — password: Dashboard → Project Settings → Database
# Direct connection (IPv6). On IPv4-only networks use Session Pooler host/port from Supabase.
# Conexao via Supavisor (pooler) em vez do host direto 'db.<ref>.supabase.co'.
# O host direto so resolve para IPv6, e os containers Docker nao tem IPv6 —
# a queue ficava em crash loop com "Network is unreachable". O pooler tem IPv4.
# O usuario passa a ser 'postgres.<project-ref>'; a porta 5432 e o modo sessao.
DB_CONNECTION=pgsql
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.kewpepanecbfkyqiqdza
DB_PASSWORD=Restaurantemuitobom
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=CG25LN8Kr9KdLMVljQwitsRCN7jXLREBM0kxK31Futu20RS9bhVFVnpfv48RscCG

REVERB_APP_ID=196469
REVERB_APP_KEY=j10jaanbljckkqbddyvm
REVERB_APP_SECRET=kqproarum26prgijfaax
# 'reverb' e o nome do servico no docker-compose: e por ele que o backend publica
# os eventos no servidor Reverb. O navegador nao enxerga esse nome — ele usa
# VITE_REVERB_HOST=localhost, definido no .env do deep-dish-frontend.
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# Onde o processo 'reverb:start' escuta dentro do container.
# 8081 em vez do default 8080 porque o frontend ja ocupa a 8080 no Compose.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
